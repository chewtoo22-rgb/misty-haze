<Window x:Class="MistyHaze.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Misty Haze" Width="1180" Height="760" MinWidth="900" MinHeight="620"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Panel2}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="#29283A"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="94"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse Width="34" Height="34" Margin="0,0,12,0">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#E9D5FF" Offset="0"/>
                        <GradientStop Color="#A855F7" Offset="0.45"/>
                        <GradientStop Color="#22D3EE" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <StackPanel>
                <TextBlock Text="MISTY HAZE" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="STANDALONE WINDOWS AGENT" FontSize="10" Foreground="{StaticResource Muted}"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" Text="● READY" Foreground="{StaticResource Accent2}" Margin="28,5,0,0" FontSize="12"/>
        </StackPanel>

        <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="14" Margin="0,0,14,0" Padding="12">
            <StackPanel>
                <TextBlock Text="MODES" Foreground="{StaticResource Muted}" FontSize="11" Margin="8,5,0,8"/>
                <Button x:Name="ChatButton" Content="CHAT" Click="Chat_Click" HorizontalContentAlignment="Left"/>
                <Button x:Name="CodeButton" Content="CODE" Click="Code_Click" HorizontalContentAlignment="Left"/>
                <Button x:Name="AgentButton" Content="AGENT" Click="Agent_Click" HorizontalContentAlignment="Left"/>
                <Separator Margin="4,18"/>
                <TextBlock Text="CONNECTION" Foreground="{StaticResource Muted}" FontSize="11" Margin="8,0,0,8"/>
                <TextBlock Text="Cloud AI" Margin="8,2"/>
                <TextBlock Text="Local Agent: planned" Foreground="{StaticResource Muted}" Margin="8,2"/>
                <TextBlock Text="Vision: planned" Foreground="{StaticResource Muted}" Margin="8,2"/>
                <TextBlock Text="Memory: planned" Foreground="{StaticResource Muted}" Margin="8,2"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource Panel}" CornerRadius="14" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ScrollViewer x:Name="ConversationScroll" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="Conversation"/>
                </ScrollViewer>
                <TextBlock x:Name="WelcomeText" Grid.Row="0" Text="Misty is ready. Ask anything." FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#DCD6EA"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Grid.Column="1" Background="{StaticResource Panel}" CornerRadius="14" Margin="0,14,0,0" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="PromptBox" Grid.Column="0" Background="#0B0B12" Foreground="{StaticResource Text}" BorderBrush="#302D43" BorderThickness="1" Padding="14" FontSize="15" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" KeyDown="Prompt_KeyDown"/>
                <Button Grid.Column="1" Content="SEND  ➜" Click="Send_Click" Width="105" Margin="10,0,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
